{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maisog-labs.internal/devos/governance/registry/rule-record.schema.json",
  "title": "Sentinel Rule Record",
  "description": "Static, machine-readable rule record shape. See RULE_RECORD_SCHEMA.md for the human-readable specification. This schema is descriptive only and is not consumed by any runtime engine in S1.",
  "type": "object",
  "required": [
    "rule_id", "title", "description", "class", "scope", "project", "risk",
    "status", "authority", "applies_when", "introduced_by", "decision_id",
    "adr_id", "effective_version", "supersedes", "created_at", "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "rule_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "class": {
      "type": "string",
      "enum": ["PATCH", "LOCAL_RULE", "CORE_POLICY", "CAPABILITY", "ARCHITECTURE", "CONSTITUTIONAL", "WAIVER", "PROJECT_ONBOARDING"]
    },
    "scope": { "type": "string", "enum": ["sentinel-wide", "project"] },
    "project": { "type": ["string", "null"] },
    "risk": { "type": "string", "enum": ["low", "medium", "high", "highest"] },
    "status": { "type": "string", "enum": ["ACTIVE", "SUPERSEDED", "WAIVED", "PROPOSED", "REJECTED"] },
    "authority": {
      "type": "object",
      "required": ["owner", "architect_sync_required", "paulo_approval_required"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "architect_sync_required": { "type": "boolean" },
        "paulo_approval_required": { "type": "boolean" }
      }
    },
    "applies_when": { "type": "string", "minLength": 1 },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["ACTOR_REPORTED", "INDEPENDENTLY_INSPECTED", "INDEPENDENTLY_REPRODUCED", "CI_ATTESTED", "RUNTIME_OBSERVED"]
          }
        },
        "qa": { "type": "boolean" },
        "independent_review": { "type": "boolean" },
        "evidence_gate": { "type": "boolean" }
      }
    },
    "exceptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "introduced_by": { "type": "string", "minLength": 1 },
    "decision_id": { "type": ["string", "null"] },
    "adr_id": { "type": ["string", "null"] },
    "effective_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "supersedes": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date" },
    "updated_at": { "type": "string", "format": "date" }
  }
}
