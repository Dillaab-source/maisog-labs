{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "devos/execution/execution-request.schema.json",
  "title": "S6 Execution Request (ML-DEVOS-RFC-019 \u00a713.1)",
  "description": "Produced by the instance owner's caller, never by a driver. S6 core never executes argv; it binds argv by SHA-256 of JSON.stringify(argv).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "request_id",
    "argv",
    "checkpoint_revision"
  ],
  "properties": {
    "instance_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "checkpoint_revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
