{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maisog-labs/devos/capabilities/capability-policy.schema.json",
  "title": "S5 capability policy document (V1)",
  "description": "ML-DEVOS-RFC-017 §6, §11. Immutable once published; any change is a new policy_version. Rejected whole if any descriptor is invalid.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "descriptors"
  ],
  "properties": {
    "policy_version": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "descriptors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "capability-descriptor.schema.json"
      }
    }
  }
}
