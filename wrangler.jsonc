{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maisog-labs",
  "compatibility_date": "2026-09-11",
  "main": "worker/index.mjs",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // WEB-INC-001 remediation (AS12-F003): explicitly pinned rather than left
    // to an implicit default. "auto-trailing-slash" redirects a file-style
    // request (e.g. /admin.html) to its canonical extensionless path
    // (/admin) instead of serving the HTML directly, so an alternate static
    // URL form is never served as a 200 outside the Worker-first auth check
    // below. Verified locally — see coordination/IMPLEMENTER_HANDOFF.md.
    "html_handling": "auto-trailing-slash",
    // WEB-INC-001: only /admin and /admin/* are routed to the Worker for
    // authentication. Every other request continues to be served asset-first,
    // exactly as before this increment. Do not widen this list or set this to
    // `true` without a separately reviewed/authorized change (ML-DEVOS-AS-011
    // AS11-F001). WEB-INC-006 (WEB-REQ-009 / ML-DEVOS-RFC-009 /
    // ML-DEVOS-AS-028 / D-031, AS28-F003) authorized /api/journal and
    // /api/journal/*: public, unauthenticated, GET-only, read-only paths,
    // classified before the Access-auth admin dispatch in
    // worker/auth.mjs's handleRequest (AS28-F010). WEB-INC-007
    // (ML-DEVOS-RFC-010 / ML-DEVOS-AS-030 / D-032, AS30-F008) authorizes
    // exactly one more, narrower widening: /api/design — an EXACT path, not
    // a wildcard (no /api/design/* is authorized) — same public/
    // unauthenticated/GET-only/read-only/classified-before-Access-auth
    // treatment. RFC-022 (ML-DEVOS-AS-132, D-105 Q2, D-106) adds exactly one
    // more: the exact path "/" (not a wildcard) for the V10 published-content
    // bridge, which falls back to the untouched artifact on any failure. No
    // other ordinary asset route becomes Worker-first.
    "run_worker_first": ["/", "/admin", "/admin/*", "/api/journal", "/api/journal/*", "/api/design"]
  },
  // Non-secret runtime configuration only (ML-DEVOS-RFC-002 §4). No secret,
  // private key, credential, or administrator identity is set here.
  // D-111 (AS137-F002): the exact values of the existing Cloudflare Access
  // application for `maisoglabs.com/admin` (app `b80acca4-ecff-4d9a-ba1b-cedff87cb25b`,
  // named "maisoglabs.com"; organization "Maisog Labs"), read read-only from
  // the Cloudflare API on 2026-09-28. The team domain is the organization's
  // auth domain as a bare host; ACCESS_AUD is that application's audience tag.
  // Neither is a secret: the AUD appears in every Access JWT. worker/auth.mjs
  // still fails closed on a missing, blank, malformed or placeholder value.
  "vars": {
    "ACCESS_TEAM_DOMAIN": "jolly-disk-0469.cloudflareaccess.com",
    "ACCESS_AUD": "ef44d36e676be36eedb87d5378b8f3fd1ed40cc34505b7261a990c166a0cea22"
  },
  // WEB-INC-005 (ML-DEVOS-RFC-003 / ML-DEVOS-AS-013 / D-024) D1 revision
  // substrate. D-098 (AS-116 post-incident hardening, ML-DEVOS-AS-125)
  // corrected an earlier claim here that `remote: false` meant this binding
  // "can never" target a production database. That was false:
  //   - `remote: false` only governs local development. `wrangler dev`,
  //     `getPlatformProxy` and the test suite bind a local Miniflare
  //     simulation instead of the real database.
  //   - A deployed Worker binds the real Cloudflare D1 database named here.
  //     The production Worker does, and AS-116 was that database running
  //     unmigrated.
  //   - The production identity is pinned explicitly by `database_id`. The
  //     `-local` suffix in `maisog-labs-web-inc-005-local` is historical and
  //     is not a local-only guarantee.
  //   - `--remote` D1 CLI commands target that production database. Any
  //     remote D1 query, write, migration or restore needs its own
  //     governance authority; this configuration grants none.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maisog-labs-web-inc-005-local",
      "database_id": "45b87574-e573-4e0f-9bb6-fbba2df29523",
      "migrations_dir": "migrations",
      "remote": false
    }
  ],
  // WEB-INC-004 (ML-DEVOS-RFC-007 / ML-DEVOS-AS-023 / D-029) media object
  // storage. D-098 corrected the same false "can never target a real bucket"
  // claim made here:
  //   - `remote: false` only keeps local development and tests on a local
  //     R2 simulation.
  //   - A deployed Worker binds the real Cloudflare R2 bucket named by
  //     `bucket_name` (`maisog-labs-web-inc-004-local` in production; again,
  //     the `-local` suffix is historical).
  //   - R2 bindings are identified by `bucket_name` alone; Wrangler has no
  //     bucket-ID field.
  //   - Any remote R2 read, write or bucket change needs its own governance
  //     authority; this configuration grants none.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "maisog-labs-web-inc-004-local",
      "remote": false
    }
  ]
}
